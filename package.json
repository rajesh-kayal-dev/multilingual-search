{
  "name": "indic_search",
  "version": "1.0.0",
  "description": "AI-powered multilingual and hyperlocal product search engine",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsup --minify --watch --onSuccess \"concurrently -k -n workers,server \\\"node dist/workers.js\\\" \\\"node dist/server.js\\\"\"",
    "build": "tsup",
    "build:prod": "tsup --minify --clean",
    "start:prod": "pnpm build:prod && NODE_ENV=production MONGO_MODE=replica node dist/server.js",
    "start:test": "pnpm build:prod && NODE_ENV=test node dist/server.js",
    "workers": "tsup && node dist/workers.js",
    "workers:test": "tsup && NODE_ENV=test node dist/workers.js",
    "ai:check": "tsup && node dist/ai-check.js",
    "seed:products": "tsup && node dist/seed-products.js",
    "seed:test": "tsup && node --import \"data:text/javascript,process.env.NODE_ENV='test';if(!process.env.MONGO_URI)process.env.MONGO_URI='mongodb://127.0.0.1:27017/indic_search-test';if(!process.env.MONGO_MODE)process.env.MONGO_MODE='replica'\" dist/seed-products.js --count=2000",
    "seed:traffic": "tsup && node dist/seed-traffic.js",
    "reindex": "tsup && node dist/reindex.js",
    "eval:search": "tsup && node dist/eval-search.js",
    "check": "tsup && node dist/checks.js",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose -f docker-compose.yml up -d",
    "infra:down": "docker compose -f docker-compose.yml down",
    "infra:status": "docker compose -f docker-compose.yml ps",
    "infra:logs": "docker compose -f docker-compose.yml logs -f --tail=100",
    "typesense:up": "docker compose --env-file .env -f docker-compose.yml up -d indic-search-typesense",
    "typesense:stop": "docker compose -f docker-compose.yml stop indic-search-typesense",
    "typesense:down": "docker compose -f docker-compose.yml stop indic-search-typesense",
    "typesense:status": "docker compose -f docker-compose.yml ps indic-search-typesense",
    "typesense:logs": "docker compose -f docker-compose.yml logs -f --tail=100 indic-search-typesense",
    "mongo:up": "docker compose -f docker-compose.yml up -d indic-search-mongo-primary indic-search-mongo-secondary-1 indic-search-mongo-secondary-2",
    "mongo:down": "docker compose -f docker-compose.yml stop indic-search-mongo-primary indic-search-mongo-secondary-1 indic-search-mongo-secondary-2",
    "mongo:status": "docker compose -f docker-compose.yml ps indic-search-mongo-*",
    "kafka:up": "docker compose -f docker-compose.yml up -d indic-search-kafka",
    "kafka:stop": "docker compose -f docker-compose.yml stop indic-search-kafka",
    "kafka:down": "docker compose -f docker-compose.yml stop indic-search-kafka",
    "kafka:status": "docker compose -f docker-compose.yml ps indic-search-kafka",
    "kafka:logs": "docker compose -f docker-compose.yml logs -f --tail=100 indic-search-kafka",
    "kafka:reset": "docker compose -f docker-compose.yml stop indic-search-kafka && docker compose -f docker-compose.yml up -d indic-search-kafka"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "mongoose": "^9.9.5",
    "redis": "^6.2.1",
    "swagger-jsdoc": "^6.3.0",
    "typesense": "^3.2.0",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "concurrently": "^10.0.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "type": "module"
}