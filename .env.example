PORT=5004
MONGO_URI=mongodb://127.0.0.1:27017/indic_search
# auto = detect standalone/replica/sharded (dev/test). production must set replica or sharded
MONGO_MODE=auto
MONGO_CIRCUIT_MS=2000
MONGO_CIRCUIT_FAILS=3
MONGO_SELECT_TIMEOUT_MS=10000
MONGO_MAX_POOL=50
MONGO_MIN_POOL=10

REDIS_URL=redis://127.0.0.1:6379/1

KAFKA_BROKERS=127.0.0.1:9094
KAFKA_CLIENT_ID=indic_search
KAFKA_TOPIC_PREFIX=indic_search.

TYPESENSE_URL=http://127.0.0.1:8108
TYPESENSE_API_KEY=your_typesense_api_key_here
TYPESENSE_COLLECTION_PREFIX=indic_search_

# Admin pages and admin APIs require this in the x-admin-key header. Required in production.
ADMIN_KEY=your_admin_key_here

LOG_LEVEL=info
NODE_ENV=development

SEARCH_REWRITE=true
RATE_LIMIT_SEARCH_PER_MIN=120
RATE_LIMIT_EVENTS_PER_MIN=300

# AI
AI_LLM_PROVIDER=ollama
AI_LLM_MODEL=gemma3:4b
# used when the main LLM fails
AI_LLM_FALLBACK=
AI_LLM_FALLBACK_MODEL=
AI_EMBED_PROVIDER=ollama
AI_EMBED_MODEL=bge-m3
# shorter vectors, only for models that support it (OpenAI, Gemini)
AI_EMBED_DIMS=
AI_TIMEOUT_MS=30000

# AI provider keys and base URLs (only the provider in use needs a key)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_CTX=2048
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
